<!--
   Резервное копирование для Android 11 и ниже (API ≤ 30).
   R20: секреты (зашифрованный пароль S900) не копируются: ключ Android Keystore в копию не
   попадает, восстановленный шифротекст всё равно не расшифруется. Остальное (БД архива, снимки,
   эталоны FFC, настройки без пароля) — по умолчанию; политика резервирования архива — Q14.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/kern_secrets.preferences_pb" />
</full-backup-content>
