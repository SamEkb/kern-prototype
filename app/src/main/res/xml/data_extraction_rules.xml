<?xml version="1.0" encoding="utf-8"?>
<!--
   Резервное копирование и перенос для Android 12+ (API ≥ 31).
   R20: секреты (зашифрованный пароль S900) исключены и из облачной копии, и из переноса на другое
   устройство: ключ Android Keystore не переносится. Остальное — по умолчанию; политика
   резервирования архива — Q14.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/kern_secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/kern_secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
