<?xml version="1.0" encoding="utf-8"?>
<!--
  USB-фильтр для авто-реакции на подключение камеры Touptek (§5).
  Нужен только для удобства: чтобы Android предложил открыть приложение при
  подключении и запомнил разрешение («использовать по умолчанию»). Основная
  проверка «наша ли камера» делается в рантайме через toupcam.get_Model(vid,pid),
  поэтому неточность этого списка НЕ ломает работу — просто не сработает авто-запуск.

  vendor-id указывается в ДЕСЯТИЧНОМ виде.
  1351 = 0x0547 — исторический VID ToupTek (подтверждён для USB2-камер;
  для USB3 «K»-серии VID/PID нужно уточнить на реальном устройстве:
  UsbManager.getDeviceList() или `lsusb`, затем добавить сюда <usb-device .../>).
-->
<resources>
    <usb-device vendor-id="1351" />
</resources>
